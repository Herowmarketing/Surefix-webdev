# ─────────────────────────────────────────────────────────────────────────────
# Sure-Fix Remodeling — Environment Variables
#
# Copy to `.env` for local `vercel dev`, and add the same values in the Vercel
# project settings (Settings → Environment Variables) for preview + production.
#
# NONE of these are exposed to the browser. They are read only by the serverless
# functions in /api. Do NOT prefix any of them with VITE_ (that would expose them).
# ─────────────────────────────────────────────────────────────────────────────

# ── Sanity (intake storage / CRM) ────────────────────────────────────────────
# Project + dataset already default to the live values in code, but you can override.
SANITY_PROJECT_ID=kqp67u17
SANITY_DATASET=production
SANITY_API_VERSION=2024-01-01
# REQUIRED. A write-enabled token. Create at:
#   https://www.sanity.io/manage/project/kqp67u17/api  → Tokens → Add API token (Editor)
SANITY_WRITE_TOKEN=

# ── Email notifications + confirmations ──────────────────────────────────────
# Optional but strongly recommended. If email vars are missing or invalid,
# submissions still save to Sanity and notificationStatus records the failure.
#
# Recommended Gmail setup: enable 2FA on the sender Gmail account, create an
# App Password, then set GMAIL_FROM_EMAIL + GMAIL_APP_PASSWORD in Vercel.
GMAIL_APP_PASSWORD=
#
# Legacy Gmail OAuth2 setup (works, but refresh tokens can expire/revoke):
#   1. Google Cloud Console → create/select a project → enable the Gmail API.
#   2. Create OAuth 2.0 Client ID (type: Web application).
#   3. Use the OAuth Playground (https://developers.google.com/oauthplayground)
#      with scope https://mail.google.com/ to mint a refresh token for the
#      sending Gmail account. (Use your own client id/secret in the Playground gear.)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# The Gmail account that sends the notification (e.g. notifications@yourdomain.com)
GMAIL_FROM_EMAIL=
# Who receives new-submission alerts (defaults to GMAIL_FROM_EMAIL if omitted)
OPERATIONS_MANAGER_EMAIL=

# Optional SMTP provider fallback (SendGrid, Mailgun, Postmark, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# ── Google Ads conversion tracking (browser — safe to prefix VITE_) ───────────
# Customer ID 1445325911 is for the Ads UI only. You need the AW- conversion ID
# from Goals → Conversions → Tag setup (looks like AW-1234567890).
# Labels are the string after the slash in send_to, e.g. AbCdEfGh in AW-xxx/AbCdEfGh
VITE_GOOGLE_ADS_ID=
VITE_GOOGLE_ADS_FORM_CONVERSION=
VITE_GOOGLE_ADS_PHONE_CONVERSION=
